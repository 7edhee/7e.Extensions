{
  "manifest_version": 3,
  "name": "7e.YTMoney — YouTube Earnings Estimator",
  "version": "1.0.0",
  "description": "Estimate YouTube earnings from views and RPM assumptions.",
  "action": {
    "default_title": "7e.YTMoney",
    "default_popup": "popup.html"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://www.youtube.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
